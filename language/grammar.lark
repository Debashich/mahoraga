start: investigation

investigation: ("investigation" | "investigate") (ESCAPED_STRING | CNAME) "{" statement* "}"

?statement: collect_stmt 
          | correlate_stmt 
          | emit_stmt 
          | detect_stmt

collect_stmt: "collect" OPERATION ["as" CNAME]
correlate_stmt: "correlate" CNAME "with" CNAME
emit_stmt: "emit" EMIT_TARGET

OPERATION: "process_list"
         | "system_info"
         | "users"
         | "network_connections"
         | "auth_logs"
         | "file_metadata"
         | "memory_snapshot"
         | "driver_scan"
         | "kernel_callbacks"
         | "registry_hives"
         | "event_logs"

capability: "process_list"
          | "system_info"
          | "users"
          | "network_connections"
          | "auth_logs"

EMIT_TARGET: "evidence" | "report" | "timeline"

%import common.CNAME
%import common.NUMBER
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
%ignore /#[^\n]*/

detect_stmt: "detect" CNAME "{" assignment+ "}"
assignment: CNAME "=" (CNAME | NUMBER | ESCAPED_STRING)
